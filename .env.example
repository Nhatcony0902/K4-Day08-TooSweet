# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: extractive | openai | gemini | anthropic
# "extractive" chạy offline; cài extra "providers" trước khi đổi sang API provider.
LLM_PROVIDER=extractive
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: hashing (offline) | sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=hashing-1024

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.4115
